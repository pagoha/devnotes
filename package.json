{
  "devDependencies": {
    "cspell": "^9.4.0",
    "markdownlint-cli": "^0.47.0"
  },
  "scripts": {
    "lint:md": "markdownlint \"notes/**/*.md\" \"snippets/**/*.md\" --config ./markdownlint.json",
    "lint:spell": "cspell \"notes/**/*.md\" \"snippets/**/*.md\" --config ./cspell.json",
    "lint:all": "npm run lint:md && npm run lint:spell"
  }
}
